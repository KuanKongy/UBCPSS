# Supabase (public site reads + /admin dashboard).
# Copy to .env (gitignored) and fill in from Supabase Dashboard → Settings → API.
# Set the two VITE_ vars in Vercel too (Production + Preview).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Secret. Only read by `node --env-file=.env scripts/seed-cms.mjs`.
# Never put this in Vercel or anywhere client-visible.
SUPABASE_SERVICE_ROLE_KEY=
